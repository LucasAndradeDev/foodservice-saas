# Copie este arquivo para .env e preencha com valores reais.
# .env já está no .gitignore e nunca deve ser commitado.

# Opção 1: banco remoto (ex: Supabase)
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/<database>?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# Opção 2: Postgres local via docker-compose (docker compose up -d)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/restaurant_saas
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres

# Gere uma chave secreta forte e única (ex: openssl rand -base64 64)
JWT_SECRET=