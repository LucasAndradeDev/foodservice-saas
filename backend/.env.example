# Copy this file to .env and fill in real values.
# .env is already in .gitignore and must never be committed.

# Option 1: remote database (e.g. Supabase)
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/<database>?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# Option 2: local Postgres via docker-compose (docker compose up -d)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/restaurant_saas
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres

# Generate a strong, unique secret key (e.g. openssl rand -base64 64)
JWT_SECRET=

# Google Gemini API key for AI-assisted menu import (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: override the Gemini model used for extraction
# GEMINI_MODEL=gemini-flash-latest

# File uploads (product photos, restaurant logo). Defaults to local disk, which is
# fine for local dev but is lost on every deploy on hosts without a persistent disk
# (e.g. Render's free tier). Set to "supabase" in production and fill in the vars below.
# STORAGE_PROVIDER=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=uploads

# URL of the frontend, used to build the password reset link sent by email.
# FRONTEND_URL=https://<your-frontend-domain>

# Database backup (POST /api/v1/internal/backups, meant to be called by a scheduled job, not a
# user). Needs SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY above too, plus a *private* bucket created
# by hand in the Supabase dashboard (separate from the public "uploads" bucket used for images).
# Generate BACKUP_TRIGGER_TOKEN with `openssl rand -base64 32`; without it set, the endpoint
# rejects every request. Give the same value to the GitHub Actions secret that calls this endpoint.
# BACKUP_TRIGGER_TOKEN=
# SUPABASE_BACKUP_BUCKET=backups
# BACKUP_RETENTION_COUNT=14

# Password reset email. Defaults to "log" (writes the reset link to the app log
# instead of sending a real email — fine for local dev). Set to "brevo" in production
# and fill in the vars below (https://app.brevo.com, Settings > SMTP & API > API Keys;
# sender email must be verified under Senders, Domains & Dedicated IPs > Senders).
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=Morá
