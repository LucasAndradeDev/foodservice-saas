# Copy this file to .env and fill in real values.
# .env is already in .gitignore and must never be committed.

# Option 1: remote database (e.g. Supabase)
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/<database>?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# Option 2: local Postgres via docker-compose (docker compose up -d)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/restaurant_saas
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres

# Generate a strong, unique secret key (e.g. openssl rand -base64 64)
JWT_SECRET=

# Platform admin login (POST /api/v1/admin/login) — lets the Morá owner block/unblock a
# restaurant and set its payment due date, separate from any restaurant's own users.
# ADMIN_PASSWORD_HASH is a bcrypt hash, not the plain password — generate one with
# `new BCryptPasswordEncoder().encode("your-password")` (any Spring Security Java snippet).
# These three vars only seed the admin_credentials DB row on first boot (see
# AdminCredentialsSeeder) — after that the row is authoritative and forgot-password (below)
# updates it directly, so changing these vars later has no effect.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Needed for the admin "forgot password" flow (POST /api/v1/admin/forgot-password) to know
# where to send the reset link. Without it, admin password recovery is impossible short of
# editing the admin_credentials row directly in the database.
ADMIN_EMAIL=

# Google Gemini API key for AI-assisted menu import (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: override the fallback chain of Gemini models used for extraction (comma-separated,
# tried in order - see application.yml for why)
# GEMINI_MODELS=gemini-flash-latest,gemini-3.6-flash,gemini-3.1-flash-lite

# File uploads (product photos, restaurant logo). Defaults to local disk, which is
# fine for local dev but is lost on every deploy on hosts without a persistent disk
# (e.g. Render's free tier). Set to "supabase" in production and fill in the vars below.
# STORAGE_PROVIDER=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=uploads

# URL of the frontend, used to build the password reset link sent by email.
# FRONTEND_URL=https://<your-frontend-domain>

# This backend's own publicly reachable URL, used to build the notification_url Mercado Pago
# calls back on for card payment webhooks (docs/CARD_PAYMENT.md) - Checkout Pro needs a URL we
# register ourselves, unlike Woovi's Pix webhook. Localhost is useless for a real webhook; use an
# ngrok tunnel when testing that flow locally.
# BACKEND_URL=https://<your-backend-domain>

# Database backup (POST /api/v1/internal/backups, meant to be called by a scheduled job, not a
# user). Needs SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY above too, plus a *private* bucket created
# by hand in the Supabase dashboard (separate from the public "uploads" bucket used for images).
# Generate BACKUP_TRIGGER_TOKEN with `openssl rand -base64 32`; without it set, the endpoint
# rejects every request. Give the same value to the GitHub Actions secret that calls this endpoint.
# BACKUP_TRIGGER_TOKEN=
# SUPABASE_BACKUP_BUCKET=backups
# BACKUP_RETENTION_COUNT=14

# Password reset email. Defaults to "log" (writes the reset link to the app log
# instead of sending a real email — fine for local dev). Set to "brevo" in production
# and fill in the vars below (https://app.brevo.com, Settings > SMTP & API > API Keys;
# sender email must be verified under Senders, Domains & Dedicated IPs > Senders).
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=Morá

# SSO into Armazém Morá (docs/ARMAZEM_MORA.md) - the sidebar link mints a ~60s handoff token
# signed with this secret, shared with the Armazém Morá backend, which verifies it and mints
# its own session. Deliberately a DIFFERENT secret from JWT_SECRET above - a leak here only
# lets someone forge a short-lived handoff, not a full Morá session.
# Generate with `openssl rand -base64 64`, same as JWT_SECRET.
WAREHOUSE_SSO_SECRET=
# URL of the Armazém Morá frontend, used to build the SSO handoff link.
# WAREHOUSE_FRONTEND_URL=http://localhost:5174

# Restricted runtime role used by Hibernate for Row-Level Security (Camada 3, see
# docs/RLS_DESIGN.md). Flyway and the backup job keep using SPRING_DATASOURCE_* (the
# table-owning role) above; only application traffic goes through this one, which is
# subject to Postgres Row-Level Security policies. Same host/database as SPRING_DATASOURCE_URL
# locally. In production (or any pooled Postgres, e.g. Neon), this MUST be a direct
# connection, never one through a transaction-mode pooler (e.g. Neon's "-pooler" endpoint) -
# TenantAwareDataSource sets app.tenant_id with a session-level set_config once per pooled
# connection checkout, which silently stops working if the pooler can reassign that logical
# connection to a different physical backend between transactions. Found the hard way in
# production on 2026-08-11 - see docs/RLS_DESIGN.md, Achado 4.
# APP_DATASOURCE_RUNTIME_URL=jdbc:postgresql://localhost:5432/restaurant_saas
# APP_DATASOURCE_RUNTIME_USERNAME=app_runtime
# APP_DATASOURCE_RUNTIME_PASSWORD=app_runtime_local_dev_only

# Master key for CredentialEncryptionService (docs/PIX_PAYMENT.md, docs/CARD_PAYMENT.md) -
# encrypts each restaurant's own Woovi AppID (pix_integrations.api_key_encrypted) and Mercado
# Pago access token/webhook secret (card_integrations.*_encrypted) at rest. Required, no
# default - the app won't start without it. Generate with `openssl rand -base64 32`.
PIX_ENCRYPTION_KEY=

# Error tracking (Sentry, https://sentry.io). Blank by default, which leaves the SDK
# disabled - fine for local dev, and no account is needed to run the app. Set in
# production only (see render.yaml).
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
