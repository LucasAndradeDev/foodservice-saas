# Copy this file to .env and fill in real values.
# .env is already in .gitignore and must never be committed.

# Local Postgres via docker-compose at the repo root (docker compose up -d warehouse_db)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/armazem_mora
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Shared with the Morá backend - signs/verifies the short-lived SSO handoff token minted when
# an owner/manager clicks "Armazém Morá" in the Morá sidebar. Deliberately NOT the same secret
# as Morá's JWT_SECRET (see docs/ARMAZEM_MORA.md) - a leak here only lets someone forge a
# 30-60s handoff code, not a full Morá session.
# Generate with `openssl rand -base64 64`. Must match Morá's WAREHOUSE_SSO_SECRET exactly.
WAREHOUSE_SSO_SECRET=

# This app's own session token, minted after a handoff token is verified. NOT shared with
# Morá - generate independently, e.g. `openssl rand -base64 64`.
WAREHOUSE_JWT_SECRET=
# WAREHOUSE_JWT_EXPIRATION_MS=86400000

# Where the stock sync (WarehouseSyncService) pulls delivered sales from. Defaults to the Morá
# backend's own local default port, so this rarely needs setting for local dev.
# MORA_BACKEND_URL=http://localhost:8080

# Shared secret for the GitHub Actions cron that triggers POST /api/v1/internal/sync every 15
# minutes. Generate with `openssl rand -base64 32`; without it set, the endpoint always 401s.
# SYNC_TRIGGER_TOKEN=
